# ============================================================
#  VILLAGE 1800 — Variables d'environnement
#  Copier ce fichier en `.env` et remplir les valeurs.
#  NE JAMAIS commiter le fichier .env (déjà dans .gitignore).
# ============================================================

# --- Environnement ------------------------------------------
NODE_ENV=development          # development | production

# --- Serveur ------------------------------------------------
PORT=3000                     # Railway injecte automatiquement PORT en prod

# --- Base de données MySQL ---------------------------------
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=village1800

# --- Authentification JWT ----------------------------------
# ⚠ Générer une chaîne aléatoire longue (au moins 32 caractères)
# Exemple : openssl rand -hex 32
JWT_SECRET=change_me_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# --- CORS ---------------------------------------------------
# Domaines autorisés à appeler l'API (séparés par virgule)
# En prod : mettre l'URL Vercel du frontend
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# --- Cloudinary (upload images produits) -------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Admin initial (script create-admin) --------------------
# Le script utilise cette valeur si présente, sinon prompt interactif
ADMIN_EMAIL=admin@village1800.com
ADMIN_INITIAL_PASSWORD=
